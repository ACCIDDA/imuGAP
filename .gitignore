docs/

# Vignette caching items
Meta/
doc/

# Regenerated by roxygen2() in CI (#53, #115): man pages, NAMESPACE, and the
# roxyglobals-managed R/globals.R are all documentation-process output, so the
# build regenerates them rather than tracking them. Every workflow that builds,
# installs, or checks the package runs `roxygen2::roxygenise()` first (which
# bootstraps a missing NAMESPACE). man/figures/ stays tracked because the
# package logo and other curated assets aren't roxygen output.
man/*.Rd
R/globals.R
.bin/

# Fit-derived artifacts regenerated on build by data-raw/fit_data.R (#64). The
# *_sim inputs (locations/observations/populations_sim) and latent_params_sim
# (#105) stay tracked; these three are fit-derived and large/version-fragile, so
# they are not.
data/fit_sim*.rda
data/target_sim*.rda
data/predict_sim*.rda

# Diagram artifacts generated from .mmd sources prior to building vignettes
vignettes/figures/*.svg
vignettes/figures/*.png
vignettes/figures/*.pdf

# Vignette render outputs
vignettes/*.html
vignettes/*.pdf

# Benchmark intermediate objects, datasets, results, and rendered figures
data-raw/benchmarks/benchobjs/
data-raw/benchmarks/results_parts/
data-raw/benchmarks/logs/
data-raw/benchmarks/*.rds
data-raw/benchmarks/*.csv
data-raw/benchmarks/figures/
data-raw/benchmarks/test_output.log
